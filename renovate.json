{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Pin Docker images to digest",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "description": "Automerge non-major Composer and Dockerfile updates",
      "matchManagers": ["composer", "dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "PHP image: only patch and digest updates, no new minor/major PHP versions",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"],
    "automerge": true,
    "ignoreTests": true
  },
  "vulnerabilityAlerts": {
    "description": "Raise security updates immediately; non-major ones are automerged by packageRules, major ones are not",
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  }
}
